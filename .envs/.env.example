# Copy this file to .env.local and fill in real values.
# All variables listed here are required unless marked optional.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=add-secret-key

# Database (Postgres)
POSTGRES_DB=spotter_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Routing
ORS_API_KEY=your-openrouteservice-api-key
ROUTE_PROVIDER=ors

# Geocoding (optional — only needed when re-running the geocode command)
MAPQUEST_API_KEY=your-mapquest-api-key
